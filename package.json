{
  "name": "deepseek-desk-pet",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Always-on-top DeepSeek Harness desk pet with a native menu and DIY skins. Shows what your agent is doing: working, waiting, finished, failed. Five skins, or make your own from one image. No dependencies.",
  "author": "anneheartrecord (https://github.com/anneheartrecord)",
  "homepage": "https://github.com/anneheartrecord/dsh-desk-pet#readme",
  "bugs": "https://github.com/anneheartrecord/dsh-desk-pet/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anneheartrecord/dsh-desk-pet.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet"
  ],
  "bin": {
    "dsh-desk-pet": "bin/dsh-desk-pet"
  },
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/skins/manifest.json",
    "assets/web",
    "bin",
    "plugin",
    "skills",
    "src",
    "cordis.patch.yml",
    "docs/media",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "start": "bin/dsh-desk-pet",
    "test": "/usr/bin/python3 -m unittest discover -t . -s tests -v"
  },
  "os": [
    "darwin"
  ]
}
